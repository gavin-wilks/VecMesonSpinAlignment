  h_FrameEta = (TH1D*)((TH1D*)File_Kplus->Get("h_FrameEta_K"))->Clone();
  h_FramePhi = (TH1D*)((TH1D*)File_Kplus->Get("h_FramePhi_K"))->Clone();
 
  int neta = h_FrameEta->GetNbinsX(); 
  int nphi = h_FramePhi->GetNbinsX();


  for(int i_cent = 0; i_cent < 10; ++i_cent)
